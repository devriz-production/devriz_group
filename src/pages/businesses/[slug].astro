---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { sectors, type Sector } from '../../data/sectors';
import { companiesIn } from '../../data/companies';

export function getStaticPaths() {
  return sectors.map((sector) => ({ params: { slug: sector.slug }, props: { sector } }));
}

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;
const list = companiesIn(sector.slug);
const index = sectors.findIndex((s) => s.slug === sector.slug);
const next = sectors[(index + 1) % sectors.length];
const crumbs = [{ label: 'Businesses', href: '/businesses/' }, { label: sector.name }];
---

<Base title={sector.name} description={`${sector.tagline} ${sector.summary}`} crumbs={crumbs}>
  <PageHead title={sector.name} lede={sector.tagline} crumbs={crumbs} image={{ id: sector.image, alt: sector.imageAlt }} />

  <!-- Overview -->
  <section class="section">
    <div class="wrap grid gap-x-16 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <h2 class="display-md">{sector.summary}</h2>
        <div class="mt-8 grid max-w-[62ch] gap-5 text-[1.0625rem] leading-relaxed">
          {sector.overview.map((p) => <p>{p}</p>)}
        </div>
      </div>
      {
        sector.facts && (
          <dl class="grid content-start gap-px self-start border border-line bg-line lg:col-span-4 lg:col-start-9" data-reveal style="--i:1">
            {sector.facts.map((f) => (
              <div class="flex flex-col-reverse gap-2 bg-surface p-6">
                <dt class="meta">{f.label}</dt>
                <dd class="figure text-3xl">{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section border-y border-line bg-bg-2">
    <div class="wrap">
      <h2 class="display-lg" data-reveal>What we do</h2>
      <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          sector.capabilities.map((c, i) => (
            <li class="border-t-2 border-ink pt-6" data-reveal style={`--i:${i % 3}`}>
              <h3 class="display-sm">{c.title}</h3>
              <p class="mt-3 max-w-[40ch] text-ink-2">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Companies -->
  <section class="section" id="companies">
    <div class="wrap">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <h2 class="display-lg">{list.length === 1 ? 'The company in this sector' : 'Companies in this sector'}</h2>
        <a href={`/companies/?sector=${sector.slug}`} class="link-arrow shrink-0">
          Open in the directory
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          list.map((c, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <CompanyCard company={c} showSector={false} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Approach -->
  {
    sector.approach && (
      <section class="section border-t border-line">
        <div class="wrap grid gap-x-16 gap-y-10 lg:grid-cols-12">
          <div class="self-start lg:sticky lg:top-28 lg:col-span-5" data-reveal>
            <h2 class="display-md">{sector.approach.heading}</h2>
          </div>
          <ol class="border-b border-line lg:col-span-6 lg:col-start-7">
            {sector.approach.steps.map((step, i) => (
              <li class="border-t border-line py-6" data-reveal style={`--i:${i}`}>
                <h3 class="display-sm">{step.title}</h3>
                <p class="mt-2 max-w-[52ch] text-ink-2">{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- Next sector -->
  <section class="border-t border-line">
    <a href={`/businesses/${next.slug}/`} class="group wrap flex items-center justify-between gap-8 py-12 lg:py-16">
      <span>
        <span class="meta block">Next sector</span>
        <span class="display-md mt-3 block font-display font-semibold text-ink">{next.name}</span>
      </span>
      <Icon name="arrow-right" size={36} class="shrink-0 text-ink transition-transform duration-500 group-hover:translate-x-2" />
    </a>
  </section>

  <CtaBand heading="Work with this business." text="For partnerships, supply or services in this sector, write to the corporate office and we will route you to the right company." href={`/contact/?enquiry=partnership&sector=${sector.slug}`} />
</Base>

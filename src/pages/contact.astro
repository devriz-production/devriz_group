---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';

const crumbs = [{ label: 'Contact' }];
const mapUrl = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;

const routes = [
  { label: 'Careers', text: 'Apply through the careers page so your application reaches HR.', href: '/careers/#apply', cta: 'Apply' },
  { label: 'Grievances', text: 'Concerns about a product, service or conduct follow the grievance process.', href: '/policies/grievance-redressal/', cta: 'Grievance redressal' },
  { label: 'Recruitment fraud', text: 'Approached by someone asking for money for a job? Report it.', href: '/careers/recruitment-fraud-alert/', cta: 'Fraud alert' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${site.url}/contact/`,
  about: { '@id': `${site.url}/#organization` },
};
---

<Base
  title="Contact"
  description="Contact Devriz Group: partnership, vendor, media and general enquiries, with corporate and registered office addresses in Noida and New Delhi."
  crumbs={crumbs}
  schema={schema}
>
  <PageHead
    title="Contact us"
    lede="Partnership, vendor, media and general enquiries all reach the corporate office in Noida. Choose a type below so your message goes to the right person."
    crumbs={crumbs}
    narrow
  />

  <section class="section">
    <div class="wrap grid gap-x-16 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="display-md">Send an enquiry</h2>
        <div class="mt-8">
          <EnquiryForm />
        </div>
      </div>

      <aside class="self-start lg:col-span-4 lg:col-start-9" id="offices">
        <h2 class="display-sm">Offices</h2>
        <dl class="mt-6 border-b border-line">
          {
            site.offices.map((office) => (
              <div class="border-t border-line py-6">
                <dt class="meta">{office.label}</dt>
                <dd class="mt-3">
                  <address class="not-italic leading-relaxed text-ink">
                    {office.lines.map((line) => (
                      <span class="block">{line}</span>
                    ))}
                  </address>
                  <a href={mapUrl(office.mapQuery)} target="_blank" rel="noopener noreferrer" class="link-arrow mt-3 text-sm">
                    Open in Google Maps
                    <Icon name="arrow-up-right" size={15} />
                  </a>
                </dd>
              </div>
            ))
          }
          <div class="border-t border-line py-6">
            <dt class="meta">General enquiries</dt>
            <dd class="mt-3 grid gap-1">
              <a href={site.phoneHref} class="link-underline w-fit font-medium text-ink">{site.phone}</a>
              <a href={`mailto:${site.email}`} class="link-underline w-fit font-medium text-ink">{site.email}</a>
            </dd>
          </div>
          <div class="border-t border-line py-6">
            <dt class="meta">GSTIN</dt>
            <dd class="mt-3 font-mono text-[0.9375rem] text-ink">{site.gstin}</dd>
          </div>
        </dl>
        <ul class="mt-6 flex gap-2">
          {
            site.social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-11 items-center gap-2 border border-line-2 px-4 text-sm font-medium text-ink transition-colors hover:border-ink"
                >
                  <Icon name={s.icon} size={18} />
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="section border-t border-line bg-bg-2">
    <div class="wrap">
      <h2 class="display-md">Looking for something else?</h2>
      <ul class="mt-10 grid gap-5 lg:grid-cols-3">
        {
          routes.map((r) => (
            <li>
              <a href={r.href} class="group flex h-full flex-col justify-between gap-8 border border-line-2 bg-surface p-6 transition-colors hover:border-ink lg:p-7">
                <span>
                  <span class="display-sm block font-display font-semibold text-ink">{r.label}</span>
                  <span class="mt-2 block text-ink-2">{r.text}</span>
                </span>
                <span class="flex items-center gap-2 text-sm font-semibold text-ink">
                  {r.cta}
                  <Icon name="arrow-right" size={16} class="transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

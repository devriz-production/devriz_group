---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { chairman, chairmanMessage, leadershipValues } from '../data/people';
import { sectors } from '../data/sectors';
import { companiesIn, trusts } from '../data/companies';
import { site } from '../data/site';

const crumbs = [{ label: 'Leadership', href: '/leadership/' }, { label: chairman.name }];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: chairman.name,
  jobTitle: 'Chairman',
  worksFor: { '@id': `${site.url}/#organization` },
  url: `${site.url}/chairman-krishna-kumar-singh/`,
  description: chairman.bio,
};
---

<Base
  title="Krishna Kumar Singh, Chairman"
  description="Profile and message of Krishna Kumar Singh, Chairman of Devriz Group: building trusted Indian businesses with discipline, systems and long-term thinking."
  crumbs={crumbs}
  schema={schema}
>
  <!-- Profile header -->
  <section class="border-b border-line">
    <div class="wrap pb-14 pt-8 lg:pb-20 lg:pt-10">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] text-ink-3">
          <li><a href="/" class="transition-colors hover:text-ink">Home</a></li>
          <li class="flex items-center gap-x-2">
            <Icon name="caret-right" size={11} />
            <a href="/leadership/" class="transition-colors hover:text-ink">Leadership</a>
          </li>
          <li class="flex items-center gap-x-2">
            <Icon name="caret-right" size={11} />
            <span aria-current="page" class="text-ink-2">{chairman.name}</span>
          </li>
        </ol>
      </nav>
      <div class="mt-10 grid items-end gap-x-16 gap-y-10 lg:mt-14 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow">Chairman, Devriz Group</p>
          <h1 class="display-xl mt-5">{chairman.name}</h1>
          <p class="lede mt-7">
            Leading Devriz Group across healthcare, infrastructure, agriculture, logistics, technology and social impact with trust, discipline
            and long-term vision.
          </p>
          <a href="#message" class="btn btn-primary mt-9">
            Read the Chairman’s message
            <Icon name="arrow-down" size={18} />
          </a>
        </div>
        <div class="lg:col-span-5">
          <Media id={chairman.image} alt={`${chairman.name}, Chairman of Devriz Group`} ratio="4/5" sizes="(min-width: 1024px) 40vw, 100vw" position="50% 20%" priority />
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="wrap grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="display-md">Building businesses through systems, trust and disciplined execution.</h2>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--i:1">
        <p class="text-[1.0625rem] leading-relaxed">{chairman.bio}</p>
        <ul class="mt-10 border-b border-line">
          {
            leadershipValues.map((v) => (
              <li class="grid gap-1 border-t border-line py-5 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <span class="font-display text-lg font-semibold tracking-tight text-ink">{v.title}</span>
                <span class="text-[0.9375rem] text-ink-2">{v.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Message -->
  <section class="section border-y border-line bg-bg-2" id="message">
    <div class="wrap grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <h2 class="eyebrow">Chairman’s message</h2>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <p class="display-lg font-display font-semibold text-ink">{chairmanMessage.heading}</p>
        <div class="mt-10 grid max-w-[62ch] gap-6 text-lg leading-relaxed text-ink-2">
          {chairmanMessage.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="mt-12 border-t border-line-2 pt-6">
          <span class="block font-display text-xl font-semibold text-ink">{chairman.name}</span>
          <span class="meta mt-1 block">Chairman, Devriz Group</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Group ecosystem -->
  <section class="section">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <h2 class="display-lg">The group he leads</h2>
        <p class="lede mt-5">Seven sectors, their companies, and three trusts for community and animal welfare.</p>
      </div>
      <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
        {
          sectors.map((s, i) => (
            <li class="border-t-2 border-ink pt-5" data-reveal style={`--i:${i % 4}`}>
              <h3>
                <a href={`/businesses/${s.slug}/`} class="font-display text-lg font-semibold tracking-tight text-ink hover:text-accent-ink">
                  {s.name}
                </a>
              </h3>
              <ul class="mt-3 grid gap-1.5 text-[0.9375rem]">
                {companiesIn(s.slug).map((c) => (
                  <li>
                    <a href={`/companies/${c.slug}/`} class="text-ink-2 transition-colors hover:text-ink">
                      {c.name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
        <li class="border-t-2 border-accent pt-5" data-reveal style="--i:3">
          <h3>
            <a href="/impact/" class="font-display text-lg font-semibold tracking-tight text-ink hover:text-accent-ink">Social impact</a>
          </h3>
          <ul class="mt-3 grid gap-1.5 text-[0.9375rem] text-ink-2">
            {trusts.map((t) => <li>{t.name}</li>)}
          </ul>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand heading="Meet the wider leadership." text="The people who run the group’s businesses day to day." label="Meet the leadership" href="/leadership/" />
</Base>

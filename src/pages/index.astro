---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Media from '../components/Media.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { figures, site } from '../data/site';
import { sectors } from '../data/sectors';
import { companies, companiesIn, getCompany } from '../data/companies';
import { chairman, leaders } from '../data/people';
import { groupFaq, faqSchema, growthModel } from '../data/faqs';
import { coverage } from '../data/news';
import { findImage } from '../lib/images';

const featured = ['devriz-healthcare', 'kotil-skin-science', 'global-alpha-tech'].map(getCompany);
const [lead, ...others] = featured;
const sectorName = (slug: string) => sectors.find((s) => s.slug === slug)!.name;
const logos = coverage.map((c) => ({ ...c, image: findImage(c.logo) })).filter((c) => c.image);
const number = new Intl.NumberFormat('en-IN');
const scrim = 'background:linear-gradient(90deg,rgb(var(--scrim)/.9) 0%,rgb(var(--scrim)/.68) 42%,rgb(var(--scrim)/.18) 100%),linear-gradient(0deg,rgb(var(--scrim)/.55) 0%,rgb(var(--scrim)/0) 45%)';
---

<Base title="Devriz Group | Diversified multi-sector business group in India" schema={faqSchema(groupFaq)}>
  <!-- Hero -->
  <section class="relative isolate flex min-h-[34rem] items-end overflow-hidden lg:h-[calc(100dvh-7rem)] lg:max-h-[54rem] lg:min-h-[38rem]">
    <Media
      id="home-hero"
      fallback="home-hero-current"
      alt="Farmland, construction, logistics, a clinic and residential towers in one landscape at sunset"
      sizes="100vw"
      class="-z-20"
      position="60% 50%"
      fill
      priority
    />
    <div class="absolute inset-0 -z-10" style={scrim}></div>
    <div class="wrap pb-14 pt-24 lg:pb-20">
      <h1 class="display-xl hero-in text-[#fdfdfd]" style="--i:0">
        <span class="block">Built on systems.</span>
        <span class="block">Grown with discipline.</span>
      </h1>
      <p class="hero-in mt-6 max-w-[54ch] text-lg leading-relaxed text-[#fdfdfd]/85 lg:text-xl" style="--i:1">
        Devriz Group builds and operates companies across healthcare, technology, infrastructure, consumer products, agriculture, logistics and
        education.
      </p>
      <div class="hero-in mt-9 flex flex-wrap gap-3" style="--i:2">
        <a href="/businesses/" class="btn btn-primary">
          Explore our businesses
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/about/" class="btn btn-on-photo">About the group</a>
      </div>
    </div>
  </section>

  <!-- Figures -->
  <section class="border-b border-line" aria-label="Devriz Group in numbers">
    <dl class="wrap grid grid-cols-2 lg:grid-cols-4">
      {
        figures.map((f, i) => (
          <div class:list={['flex flex-col-reverse gap-3 py-8 lg:py-11', i % 2 === 1 && 'border-l border-line pl-6', i > 1 && 'border-t border-line lg:border-t-0', i > 0 && 'lg:border-l lg:pl-10']}>
            <dt class="meta">{f.label}</dt>
            <dd class="figure text-5xl lg:text-7xl">
              <span data-count={f.value} data-suffix={f.suffix}>
                {`${number.format(f.value)}${f.suffix}`}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Businesses -->
  <section class="section">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <h2 class="display-lg">Seven sectors, one operating standard.</h2>
        <p class="lede mt-5">Each company runs its own operations and answers to a common standard for governance, reporting and quality.</p>
      </div>
      <div class="mt-12 grid gap-x-16 gap-y-10 lg:mt-16 lg:grid-cols-12" data-preview-group>
        <ul class="border-b border-line lg:col-span-7">
          {
            sectors.map((s, i) => (
              <li class="border-t border-line" data-reveal style={`--i:${i}`}>
                <a href={`/businesses/${s.slug}/`} class="sector-row group flex items-center gap-5 py-5 lg:py-6" data-preview-row={s.slug} data-active={i === 0 ? '' : undefined}>
                  <Icon name={s.icon} size={28} class="sector-icon shrink-0 text-ink-3 transition-colors duration-300" />
                  <span class="min-w-0 flex-1">
                    <span class="display-sm block font-display font-semibold text-ink">{s.name}</span>
                    <span class="mt-1 block text-[0.9375rem] text-ink-3">{s.summary}</span>
                  </span>
                  <span class="meta hidden shrink-0 sm:block">
                    {`${companiesIn(s.slug).length} ${companiesIn(s.slug).length === 1 ? 'company' : 'companies'}`}
                  </span>
                  <Icon name="arrow-up-right" size={20} class="shrink-0 text-ink transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="hidden lg:col-span-5 lg:block">
          <div class="sticky top-28 aspect-[4/5]">
            {
              sectors.map((s, i) => (
                <div class="sector-pane absolute inset-0" data-preview-pane={s.slug} data-active={i === 0 ? '' : undefined}>
                  <Media id={s.image} alt={s.imageAlt} sizes="(min-width: 1024px) 40vw, 100vw" class="h-full" />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Chairman's message -->
  <section class="section border-y border-line bg-bg-2">
    <div class="wrap grid items-center gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <Media id={chairman.image} alt={`${chairman.name}, ${chairman.role} of ${chairman.org}`} ratio="4/5" sizes="(min-width: 1024px) 40vw, 100vw" position="50% 20%" />
      </div>
      <div class="lg:col-span-7" data-reveal style="--i:1">
        <p class="eyebrow">Chairman’s message</p>
        <h2 class="display-lg mt-5">Building trust at scale is what matters.</h2>
        <blockquote class="mt-8 border-l-2 border-accent pl-6 font-display text-2xl font-medium leading-snug tracking-tight text-ink lg:text-[1.75rem]">
          “{chairman.quote}”
        </blockquote>
        <p class="mt-7 max-w-[58ch]">
          We focus on disciplined execution, ethical leadership, and systems that create long-term value across every business in the group.
        </p>
        <div class="mt-9 flex flex-wrap items-end justify-between gap-6 border-t border-line pt-6">
          <p>
            <span class="block font-display text-lg font-semibold text-ink">{chairman.name}</span>
            <span class="meta mt-1 block">{chairman.role}, {chairman.org}</span>
          </p>
          <a href="/chairman-krishna-kumar-singh/" class="link-arrow">
            Read the full message
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Operating model -->
  <section class="section">
    <div class="wrap grid gap-x-16 gap-y-12 lg:grid-cols-12">
      <div class="self-start lg:sticky lg:top-28 lg:col-span-5" data-reveal>
        <h2 class="display-lg">Systems before scale.</h2>
        <p class="lede mt-5">The advantage is governance, not random diversification. Every vertical makes the same four moves before it grows.</p>
        <a href="/about/" class="link-arrow mt-8">
          How the group works
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <ol class="border-b border-line lg:col-span-6 lg:col-start-7">
        {
          growthModel.map((step, i) => (
            <li class="grid grid-cols-[auto_1fr] gap-x-6 border-t border-line py-7 lg:py-9" data-reveal style={`--i:${i}`}>
              <Icon name={step.icon} size={30} class="mt-1 text-accent-ink" />
              <div>
                <h3 class="display-sm">{step.title}</h3>
                <p class="mt-2 max-w-[46ch]">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Featured companies -->
  <section class="section border-t border-line">
    <div class="wrap">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div class="max-w-2xl">
          <h2 class="display-lg">Companies built to stand on their own.</h2>
          <p class="lede mt-5">Each has its own leadership and market. All of them report to the same standard.</p>
        </div>
        <a href="/companies/" class="link-arrow shrink-0">
          {`View all ${companies.length} companies`}
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
      <div class="mt-12 grid gap-5 lg:mt-16 lg:grid-cols-12">
        <div class="card tile group flex flex-col border border-line bg-surface lg:col-span-7" data-reveal>
          <Media id={`company-${lead.slug}`} fallback={`sector-${lead.sector}`} alt="" sizes="(min-width: 1024px) 58vw, 100vw" class="aspect-[4/3] lg:aspect-auto lg:flex-1" imgClass="tile-img" />
          <div class="flex flex-wrap items-end justify-between gap-6 p-6 lg:p-8">
            <div>
              <p class="meta">{sectorName(lead.sector)}</p>
              <h3 class="display-md mt-3">
                <a href={`/companies/${lead.slug}/`} class="card-link">{lead.name}</a>
              </h3>
              <p class="mt-3 max-w-[48ch]">{lead.summary}</p>
            </div>
            {
                lead.website && (
                  <a
                    href={lead.website.href}
                    target="_blank"
                    rel="noopener"
                    class="card-action btn btn-ink btn-sm"
                    aria-label={`View business: ${lead.website.label} (opens in a new tab)`}
                  >
                    View business
                    <Icon name="arrow-up-right" size={16} />
                  </a>
                )
              }
          </div>
        </div>
        <div class="grid gap-5 lg:col-span-5">
          {
            others.map((c, i) => (
              <div class="card tile group grid border border-line bg-surface sm:grid-cols-5" data-reveal style={`--i:${i + 1}`}>
                <Media id={`company-${c.slug}`} fallback={`sector-${c.sector}`} alt="" sizes="(min-width: 1024px) 18vw, 100vw" class="aspect-[4/3] sm:col-span-2 sm:aspect-auto sm:h-full" imgClass="tile-img" />
                <div class="flex flex-col justify-between gap-8 p-6 sm:col-span-3">
                  <div>
                    <p class="meta">{sectorName(c.sector)}</p>
                    <h3 class="display-sm mt-3">
                      <a href={`/companies/${c.slug}/`} class="card-link">{c.name}</a>
                    </h3>
                    <p class="mt-2 text-[0.9375rem]">{c.summary}</p>
                  </div>
                  <div>
                    {
                c.website && (
                  <a
                    href={c.website.href}
                    target="_blank"
                    rel="noopener"
                    class="card-action btn btn-ink btn-sm"
                    aria-label={`View business: ${c.website.label} (opens in a new tab)`}
                  >
                    View business
                    <Icon name="arrow-up-right" size={15} />
                  </a>
                )
              }
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="section border-y border-line bg-bg-2">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <h2 class="display-lg">
          <span class="block">Guided by experience.</span>
          <span class="block">Driven by discipline.</span>
        </h2>
        <p class="lede mt-5">The people who set the standard for governance, execution and long-term value across every Devriz business.</p>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 lg:mt-16 lg:grid-cols-4">
        {
          leaders.map((p, i) => (
            <li data-reveal style={`--i:${i}`}>
              <Media id={p.image} alt={`${p.honorific} ${p.name}`} ratio="4/5" sizes="(min-width: 1024px) 22vw, 50vw" position="50% 15%" />
              <h3 class="mt-5 font-display text-lg font-semibold tracking-tight text-ink lg:text-xl">
                {`${p.honorific} ${p.name}`}
              </h3>
              <p class="mt-1 text-sm text-ink-3">
                {p.role}, {p.org}
              </p>
            </li>
          ))
        }
      </ul>
      <a href="/leadership/" class="link-arrow mt-12">
        Meet the leadership
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <!-- Impact -->
  <section class="relative isolate overflow-hidden">
    <Media id="impact-hero" alt="" sizes="100vw" class="-z-20" fill />
    <div class="absolute inset-0 -z-10" style={scrim}></div>
    <div class="wrap py-24 lg:py-40" data-reveal>
      <p class="eyebrow text-[#f0c14a]">Impact</p>
      <h2 class="display-lg mt-5 text-[#fdfdfd]">Growth that gives back.</h2>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-[#fdfdfd]/85">
        Through the Environment &amp; Human Welfare Trust and two gaushalas, the group supports community welfare, animal care and skilling.
      </p>
      <a href="/impact/" class="btn btn-on-photo mt-9">
        See our impact
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <!-- Careers -->
  <section class="section">
    <div class="wrap grid items-center gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:order-2 lg:col-span-6" data-reveal>
        <Media id="careers-hero" alt="Colleagues at work in a Devriz Group office" ratio="4/3" sizes="(min-width: 1024px) 46vw, 100vw" />
      </div>
      <div class="lg:col-span-6" data-reveal style="--i:1">
        <h2 class="display-lg">Work with real responsibility.</h2>
        <p class="lede mt-5">We hire people who take ownership, follow systems, learn fast and deliver measurable output.</p>
        <ul class="mt-9 border-b border-line">
          <li class="border-t border-line">
            <a href="/careers/#openings" class="group flex items-center justify-between gap-6 py-4">
              <span class="font-medium text-ink">Current openings</span>
              <span class="meta flex items-center gap-3">
                Roles across the group
                <Icon name="arrow-right" size={16} class="text-ink transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          </li>
          <li class="border-t border-line">
            <a href="/careers/#process" class="group flex items-center justify-between gap-6 py-4">
              <span class="font-medium text-ink">How we hire</span>
              <span class="meta flex items-center gap-3">
                Four steps
                <Icon name="arrow-right" size={16} class="text-ink transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          </li>
          <li class="border-t border-line">
            <a href="/careers/recruitment-fraud-alert/" class="group flex items-center justify-between gap-6 py-4">
              <span class="font-medium text-ink">Recruitment fraud alert</span>
              <span class="meta flex items-center gap-3">
                We never charge candidates
                <Icon name="arrow-right" size={16} class="text-ink transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        </ul>
        <a href="/careers/" class="btn btn-ink mt-9">
          Explore careers
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- In the media -->
  <section class="section overflow-hidden border-y border-line bg-bg-2">
    <div class="wrap flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <div>
        <h2 class="display-md">Devriz Group in the media</h2>
        <p class="mt-3 max-w-[52ch] text-ink-2">Press coverage of the group’s growth across sectors.</p>
      </div>
      <a href="/newsroom/" class="link-arrow shrink-0">
        Go to the newsroom
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <div class="marquee mt-12 flex" style="mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);--marquee-duration:70s">
      <!-- The animated track is its own stacking context, so it carries the band colour for the logo blend to work against. -->
      <div class="marquee-track flex w-max shrink-0 bg-bg-2">
        {
          [0, 1].map((copy) => (
            <ul class="flex shrink-0 items-center gap-x-16 pr-16" aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((l) => (
                <li class="shrink-0">
                  <a href={l.href} target="_blank" rel="noopener noreferrer" tabindex={copy === 1 ? -1 : undefined} class="block">
                    <Image src={l.image!} alt={l.outlet} height={80} class="press-logo h-9 w-auto" loading="lazy" />
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <h2 class="display-md">Frequently asked questions</h2>
        <p class="mt-4 text-ink-2">
          Something else? Write to <a href={`mailto:${site.email}`} class="link-underline text-ink">{site.email}</a>.
        </p>
      </div>
      <div class="lg:col-span-8" data-reveal style="--i:1">
        <Faq items={groupFaq} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero-in {
    animation: hero-in 1.1s var(--ease-out) both;
    animation-delay: calc(var(--i) * 110ms + 120ms);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1.75rem);
    }
  }
  .sector-row[data-active] .sector-icon,
  .sector-row:hover .sector-icon {
    color: var(--accent-ink);
  }
  .sector-pane {
    opacity: 0;
    transition: opacity 0.7s var(--ease-out);
  }
  .sector-pane[data-active] {
    opacity: 1;
  }
  .tile {
    transition: border-color 0.3s var(--ease-out);
  }
  .tile:hover {
    border-color: var(--ink);
  }
  .tile :global(.tile-img) {
    transition: transform 1.2s var(--ease-out);
  }
  .tile:hover :global(.tile-img) {
    transform: scale(1.035);
  }
</style>

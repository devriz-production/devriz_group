---
// Newsletter archive. Issues are uploaded in the admin panel and listed here
// from /api/newsletters.php, newest first.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';

const crumbs = [{ label: 'Newsroom', href: '/newsroom/' }, { label: 'Newsletter' }];
---

<Base title="Newsletter" description="Issues of the Devriz Group newsletter: updates from across the group's businesses, published as PDFs." crumbs={crumbs}>
  <PageHead title="Newsletter" lede="Updates from across the group’s businesses, published as PDF issues." crumbs={crumbs} narrow />

  <section class="section">
    <div class="wrap">
      <div aria-busy="true" aria-label="Loading newsletters" data-nl-loading>
        <div class="skeleton h-24"></div>
        <div class="skeleton mt-3 h-24"></div>
        <div class="skeleton mt-3 h-24"></div>
      </div>

      <ol class="border-b border-line" data-nl-list hidden></ol>

      <div class="border border-line bg-surface p-10 lg:p-14" data-nl-empty hidden>
        <Icon name="newspaper" size={36} class="text-accent-ink" />
        <h2 class="display-md mt-6">The first issue will be published here.</h2>
        <p class="mt-4 max-w-[52ch] text-ink-2">Until then, the newsroom has the group’s press releases and coverage.</p>
        <a href="/newsroom/" class="link-arrow mt-7">
          Go to the newsroom
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <div class="border border-line bg-surface p-10" role="alert" data-nl-error hidden>
        <h2 class="display-sm">The newsletter list could not be loaded.</h2>
        <p class="mt-3 max-w-[52ch] text-ink-2">
          Check your connection and try again. If it keeps happening, write to
          <a href={`mailto:${site.email}`} class="link-underline text-ink">{site.email}</a>.
        </p>
        <button type="button" class="btn btn-outline mt-6" data-nl-retry>Try again</button>
      </div>

      <noscript>
        <p class="text-ink-2">The newsletter list needs JavaScript. For a copy of any issue, write to {site.email}.</p>
      </noscript>
    </div>
  </section>
</Base>

<template data-nl-row>
  <li class="border-t border-line">
    <a class="group grid gap-x-10 gap-y-3 py-8 lg:grid-cols-12 lg:py-10" target="_blank" rel="noopener">
      <p class="meta lg:col-span-3"><time></time></p>
      <div class="lg:col-span-7">
        <h2 class="display-md transition-colors group-hover:text-accent-ink" data-n="title"></h2>
        <p class="mt-3 max-w-[60ch] text-ink-2" data-n="summary"></p>
      </div>
      <p class="flex items-center gap-2 self-start text-sm font-semibold text-ink lg:col-span-2 lg:justify-self-end">
        <Icon name="file-pdf" size={20} class="text-accent-ink" />
        <span data-n="size"></span>
      </p>
    </a>
  </li>
</template>

<script>
  type Issue = { id: string; title: string; date: string; summary: string; size: number; url: string };

  const loading = document.querySelector<HTMLElement>('[data-nl-loading]')!;
  const list = document.querySelector<HTMLElement>('[data-nl-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-nl-empty]')!;
  const error = document.querySelector<HTMLElement>('[data-nl-error]')!;
  const template = document.querySelector<HTMLTemplateElement>('[data-nl-row]')!;

  const dateLabel = (iso: string) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso + 'T00:00:00'));
  const sizeLabel = (bytes: number) => (bytes >= 1048576 ? `PDF, ${(bytes / 1048576).toFixed(1)} MB` : `PDF, ${Math.max(1, Math.round(bytes / 1024))} KB`);

  const show = (el: HTMLElement) => {
    for (const other of [loading, list, empty, error]) other.hidden = other !== el;
  };

  async function load() {
    show(loading);
    let issues: Issue[];
    try {
      const response = await fetch('/api/newsletters.php', { headers: { Accept: 'application/json' } });
      // No JSON means there is no server behind the page (the local preview): nothing to list.
      if (!(response.headers.get('content-type') ?? '').includes('application/json')) return show(empty);
      const data = await response.json();
      if (!response.ok || !data.ok) return show(error);
      issues = data.issues;
    } catch {
      return show(error);
    }
    if (issues.length === 0) return show(empty);

    list.replaceChildren(
      ...issues.map((issue) => {
        const row = template.content.cloneNode(true) as DocumentFragment;
        const link = row.querySelector('a')!;
        link.href = issue.url;
        link.setAttribute('aria-label', `${issue.title}, ${dateLabel(issue.date)}, opens the PDF in a new tab`);
        const time = row.querySelector('time')!;
        time.dateTime = issue.date;
        time.textContent = dateLabel(issue.date);
        row.querySelector<HTMLElement>('[data-n="title"]')!.textContent = issue.title;
        const summary = row.querySelector<HTMLElement>('[data-n="summary"]')!;
        if (issue.summary) summary.textContent = issue.summary;
        else summary.remove();
        row.querySelector<HTMLElement>('[data-n="size"]')!.textContent = sizeLabel(issue.size);
        return row;
      }),
    );
    show(list);
  }

  document.querySelector('[data-nl-retry]')?.addEventListener('click', load);
  load();
</script>

---
// Company card. The card opens the company's page on this site; companies with
// their own live website also get a "View business" button that opens it in a new tab.
import Icon from './Icon.astro';
import type { Company } from '../data/companies';
import { getSector } from '../data/sectors';

interface Props {
  company: Company;
  showSector?: boolean;
}

const { company, showSector = true } = Astro.props;
const sector = getSector(company.sector);
---

<div class="card group flex h-full min-h-56 flex-col justify-between gap-8 border border-line bg-surface p-6 transition-colors duration-300 hover:border-ink lg:p-7">
  <div>
    {showSector && <p class="meta">{sector.name}</p>}
    <p class:list={['display-sm font-display font-semibold text-ink', showSector && 'mt-3']}>
      <a href={`/companies/${company.slug}/`} class="card-link">{company.name}</a>
    </p>
    <p class="mt-2 text-[0.9375rem] text-ink-2">{company.summary}</p>
  </div>
  {
    company.website ? (
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
        <span class="text-[0.8125rem] text-ink-3">{company.website.label}</span>
        <a
          href={company.website.href}
          target="_blank"
          rel="noopener"
          class="card-action btn btn-ink btn-sm"
          aria-label={`View business: ${company.website.label} (opens in a new tab)`}
        >
          View business
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    ) : (
      <div class="flex items-center justify-between">
        <span class="text-[0.8125rem] text-ink-3">{company.entity}</span>
        <Icon name="arrow-right" size={20} class="text-ink transition-transform duration-300 group-hover:translate-x-1" />
      </div>
    )
  }
</div>

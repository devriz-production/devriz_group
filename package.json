{
  "name": "devriz-group-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Corporate website for Devriz Group. Static Astro build, deployed to Hostinger.",
  "scripts": {
    "dev": "astro dev --port 5183",
    "build": "astro build",
    "preview": "astro preview --port 5183",
    "assets:live": "node scripts/fetch-live-assets.mjs",
    "assets:brand": "node scripts/build-brand.mjs",
    "prompts": "node scripts/write-image-prompts.mjs",
    "photos": "node scripts/import-photos.mjs",
    "admin:key": "node scripts/admin-setup-key.mjs",
    "check": "astro build && node scripts/check-site.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}
